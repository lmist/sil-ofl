# Neon Postgres connection string (pooled URL preferred for serverless)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Canonical public application URL used by server-side GraphQL and CORS.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional comma-separated serialized origins for preview or partner deployments.
GRAPHQL_ALLOWED_ORIGINS=
