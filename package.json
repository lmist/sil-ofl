{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/run-tests.ts",
    "test:machines": "bun test src/machines/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "bun scripts/run-isolated-e2e.ts",
    "test:e2e:ui": "playwright test --ui",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build && bun run test:e2e:isolated",
    "analyze": "next experimental-analyze",
    "analyze:output": "next experimental-analyze --output"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@pothos/core": "^4.13.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "graphql-yoga": "^5.21.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.24",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
