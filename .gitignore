# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.context/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets; keep .env.example
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# storybook
/storybook-static/

# design-sync: staged converter scripts, build output, machine-local state.
# .ds-sync/ MUST stay ignored — it carries an npm lockfile that would otherwise
# break INV-REPO-1's single-bun-lockfile assertion (git ls-files -co).
/.ds-sync/
/ds-bundle/
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules
/.design-sync/sb-reference/
/.design-sync/dts/
